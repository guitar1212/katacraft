# --- API ---
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://katacraft:katacraft@localhost:5432/katacraft?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Optional — leave blank to disable Google login (frontend hides the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Path to the openscad binary. In docker-compose the api/worker image has it
# on PATH already (just "openscad"). If running the API natively on a host
# that has OpenSCAD installed, point this at the executable, e.g.
# "C:\Program Files\OpenSCAD\openscad.exe" on Windows.
OPENSCAD_BIN=openscad
RENDER_TIMEOUT_MS=60000

# Local disk storage root (swap StorageService implementation for S3 later)
STORAGE_DIR=./storage

SIGNUP_BONUS_CREDITS=50
DEFAULT_DOWNLOAD_CREDIT_COST=1

# --- Web ---
VITE_API_BASE_URL=http://localhost:3000
